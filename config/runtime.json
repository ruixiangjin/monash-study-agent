{
  "schemaVersion": 1,
  "knowledgeProvider": "lightrag",
  "paths": {
    "normalizedRoot": "data/normalized",
    "pythonExecutable": "services/knowledge-service/.venv/bin/python",
    "workers": {
      "lightrag": "services/knowledge-service/python/lightrag_worker.py",
      "docling": "services/knowledge-service/python/docling_worker.py",
      "memoryEmbedding": "services/memory-service/python/memory_embedding_worker.py"
    }
  },
  "lightrag": {
    "workingRoot": "data/runtime/lightrag",
    "sqlitePath": "data/runtime/monash-study-agent.sqlite",
    "llm": {
      "model": "deepseek-flash",
      "baseUrl": "https://api.deepseek.com"
    },
    "embedding": {
      "model": "BAAI/bge-m3",
      "dimension": 1024,
      "maxTokens": 8192,
      "batchSize": 4,
      "maxAsync": 1
    },
    "query": {
      "mode": "mix",
      "rerank": false,
      "topK": 20,
      "chunkTopK": 20
    }
  }
}
