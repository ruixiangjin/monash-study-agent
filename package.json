{
  "name": "monash-study-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Monash learning agent product powered by DeepSeek Harness",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck",
    "scan": "tsx scripts/scan-resources.ts --config config/sources.json --output resources/resources.json",
    "test": "tsx --test tests/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
